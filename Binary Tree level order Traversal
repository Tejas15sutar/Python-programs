class Solution:
    def levelOrder(self, root: TreeNode | None) -> list[list[int]]:
        if not root:
            return []
        Q = deque([root])
        Levels = [[root.val]]
        temp = deque()
        while Q:
            node= Q.popleft()
            if node.left: temp.append(node.left)
            if node.right: temp.append(node.right)
            if not Q:
                if temp:
                    Levels.append([n.val for n in temp])
                Q = temp
                temp = deque()
        return Levels
